{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Neuro",
  "scopeName": "source.neuro",
  "comment": "Rule order in this array is load-bearing. TextMate breaks ties between rules that match at the same offset by array position, NOT by match length, so every rule that names a declaration (`func f`, `struct S`) must precede `#keywords` — otherwise `#keywords` claims the leading keyword first and the declaration rule never runs. The same applies inside `#operators`, where longer forms are listed before the prefixes they contain.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#triple_strings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#lifetimes"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#function_declaration"
    },
    {
      "include": "#type_declarations"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#builtin_functions"
    },
    {
      "include": "#screaming_constants"
    },
    {
      "include": "#pascal_types"
    },
    {
      "include": "#parameters"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#function_calls"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.neuro",
          "match": "//.*$"
        },
        {
          "include": "#block_comment"
        }
      ],
      "comment": "The lexer has one line-comment form. `///` is not a doc comment in Neuro and is deliberately not scoped as one."
    },
    "block_comment": {
      "comment": "Block comments nest, matching the lexer's depth-counting scanner.",
      "name": "comment.block.neuro",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block_comment"
        }
      ]
    },
    "string_escapes": {
      "comment": "The escapes the string decoder accepts: \\n \\r \\t \\\\ \\\" \\0 \\{ \\xNN \\u{...}. `\\u{...}` must be matched whole here, or the interpolation rule below would read its brace as an interpolation hole.",
      "patterns": [
        {
          "name": "constant.character.escape.neuro",
          "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|x[0-9a-fA-F]{2}|[nrt\\\\\"0{])"
        },
        {
          "name": "invalid.illegal.unknown-escape.neuro",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "comment": "A `{expr}` hole. The lexer hands the hole's raw text to the parser, which re-lexes it as an expression with one restriction: a `\"` string literal terminates the enclosing token, so a hole may not contain one. `#interpolation_body` therefore omits the string rules rather than including `$self`.",
      "name": "meta.interpolation.neuro",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.interpolation.begin.neuro"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.interpolation.end.neuro"
        }
      },
      "patterns": [
        {
          "include": "#format_spec"
        },
        {
          "include": "#interpolation_body"
        }
      ]
    },
    "format_spec": {
      "comment": "`{value:>8.2f}` — align, sign, zero, width, precision, kind, as parsed by the interpolation slice.",
      "match": "(:)([<>^]?\\+?0?[0-9]*(?:\\.[0-9]+)?[?edxXbo]?)(?=\\})",
      "captures": {
        "1": {
          "name": "punctuation.separator.format-spec.neuro"
        },
        "2": {
          "name": "constant.other.format-spec.neuro"
        }
      }
    },
    "interpolation_body": {
      "patterns": [
        {
          "include": "#nested_braces"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#builtin_functions"
        },
        {
          "include": "#screaming_constants"
        },
        {
          "include": "#pascal_types"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#function_calls"
        }
      ]
    },
    "nested_braces": {
      "comment": "Keeps a hole containing a block or struct literal from ending at the inner brace, the way the lexer's brace matcher does.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#nested_braces"
        },
        {
          "include": "#interpolation_body"
        }
      ]
    },
    "triple_strings": {
      "name": "string.quoted.triple.neuro",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "include": "#string_escapes"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.neuro",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string_escapes"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "chars": {
      "comment": "Exactly one Unicode scalar between single quotes. Must precede `#lifetimes`, which would otherwise claim the opening quote of `'a'` and leave the closing quote stranded.",
      "patterns": [
        {
          "name": "string.quoted.single.neuro",
          "match": "'(?:[^'\\\\\\n]|(\\\\(?:u\\{[0-9a-fA-F]+\\}|x[0-9a-fA-F]{2}|['nrt\\\\0])))'",
          "captures": {
            "1": {
              "name": "constant.character.escape.neuro"
            }
          }
        }
      ]
    },
    "lifetimes": {
      "name": "storage.modifier.lifetime.neuro",
      "match": "'[_\\p{L}][\\p{L}\\p{N}_]*"
    },
    "imports": {
      "comment": "`import ./stats::{Summary, pick as choose}` / `import report::format as fmt`. Only path segments followed by `::` are namespaces; the names inside a `{...}` group are values or types, left to the general rules.",
      "name": "meta.import.neuro",
      "begin": "\\b(import)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.import.neuro"
        }
      },
      "end": "(?<=\\})|$",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "keyword.control.import.neuro",
          "match": "\\bas\\b"
        },
        {
          "name": "punctuation.definition.path.neuro",
          "match": "\\.{1,2}/"
        },
        {
          "name": "keyword.operator.path.neuro",
          "match": "::"
        },
        {
          "name": "entity.name.namespace.neuro",
          "match": "[_\\p{L}][\\p{L}\\p{N}_]*(?=\\s*::)"
        },
        {
          "include": "#pascal_types"
        }
      ]
    },
    "function_declaration": {
      "patterns": [
        {
          "match": "\\b(func)\\s+([_\\p{L}][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.neuro"
            },
            "2": {
              "name": "entity.name.function.neuro"
            }
          }
        }
      ]
    },
    "type_declarations": {
      "patterns": [
        {
          "match": "\\b(struct|enum|trait)\\s+([_\\p{L}][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.neuro"
            },
            "2": {
              "name": "entity.name.type.neuro"
            }
          }
        },
        {
          "match": "\\b(type|newtype)\\s+([_\\p{L}][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.neuro"
            },
            "2": {
              "name": "entity.name.type.neuro"
            }
          }
        },
        {
          "comment": "`impl Trait for Type`, `impl Type`, `impl<T> Type<T>`.",
          "match": "\\b(impl)\\s*(<[^>]*>)?\\s*([_\\p{L}][\\p{L}\\p{N}_]*)(?:\\s*<[^>]*>)?(?:\\s+(for)\\s+([_\\p{L}][\\p{L}\\p{N}_]*))?",
          "captures": {
            "1": {
              "name": "keyword.declaration.neuro"
            },
            "2": {
              "patterns": [
                {
                  "include": "#generic_parameter_list"
                }
              ]
            },
            "3": {
              "name": "entity.name.type.neuro"
            },
            "4": {
              "name": "keyword.declaration.neuro"
            },
            "5": {
              "name": "entity.name.type.neuro"
            }
          }
        }
      ]
    },
    "generic_parameter_list": {
      "patterns": [
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#pascal_types"
        },
        {
          "include": "#numbers"
        }
      ]
    },
    "labels": {
      "comment": "A loop label declaration, `outer: for ...`. A label *use* (`break outer`) is not matched: the parser needs its in-scope label table to tell `break outer` from `break value`, which a regex cannot reproduce.",
      "match": "\\b([_\\p{L}][\\p{L}\\p{N}_]*)\\s*(:)\\s*(?=for\\b|while\\b|loop\\b)",
      "captures": {
        "1": {
          "name": "entity.name.label.neuro"
        },
        "2": {
          "name": "punctuation.separator.label.neuro"
        }
      }
    },
    "attributes": {
      "comment": "`@derive(Copy, Clone)`. The `begin` requires an identifier after `@` so a bare `@` is never claimed here.",
      "name": "meta.attribute.neuro",
      "begin": "(@)([_\\p{L}][\\p{L}\\p{N}_]*)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.attribute.neuro"
        },
        "2": {
          "name": "storage.modifier.attribute.neuro"
        }
      },
      "end": "(?<=\\))|(?!\\()",
      "patterns": [
        {
          "name": "meta.attribute.arguments.neuro",
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#types"
            },
            {
              "include": "#pascal_types"
            },
            {
              "name": "variable.parameter.attribute.neuro",
              "match": "[_\\p{L}][\\p{L}\\p{N}_]*"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.neuro",
          "match": "\\b(if|else|while|for|in|break|continue|return|match|loop)\\b"
        },
        {
          "name": "keyword.declaration.neuro",
          "match": "\\b(func|struct|enum|impl|trait|import|export|module)\\b"
        },
        {
          "name": "keyword.declaration.type.neuro",
          "match": "\\b(type|newtype)\\b"
        },
        {
          "name": "keyword.mutability.neuro",
          "match": "\\b(val|mut|const)\\b"
        },
        {
          "name": "keyword.special.neuro",
          "match": "\\b(self|Self|where|as|dyn|move|unsafe)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.neuro",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|bf16|f16|f32|f64|bool|string|char|void)\\b"
        },
        {
          "comment": "Compiler-known collections and the types the prelude (`compiler/neurc/src/prelude.nr`) declares in every program.",
          "name": "support.type.neuro",
          "match": "\\b(Vec|HashMap|BTreeMap|Option|Result|OrderedF32|OrderedF64)\\b"
        },
        {
          "comment": "Lang-item traits the compiler recognises by name.",
          "name": "support.type.trait.neuro",
          "match": "\\b(Copy|Clone|Drop|PartialEq|Comparable|Hashable)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.neuro",
          "match": "\\b(true|false)\\b"
        },
        {
          "comment": "Prelude enum variants bound in every module without an import.",
          "name": "support.constant.neuro",
          "match": "\\b(Some|None|Ok|Err)\\b"
        }
      ]
    },
    "builtin_functions": {
      "name": "support.function.builtin.neuro",
      "match": "\\b(panic|assert|unreachable)\\b(?=\\s*\\()"
    },
    "screaming_constants": {
      "comment": "`const MAX_RETRIES` and friends. Two characters minimum, so a single-letter generic parameter (`T`, `N`) falls through to `#pascal_types` instead.",
      "name": "variable.other.constant.neuro",
      "match": "\\b\\p{Lu}[\\p{Lu}\\p{N}_]+\\b"
    },
    "pascal_types": {
      "comment": "Any remaining capitalised name reads as a type. This is what colours user types at every *use* site; declaration sites are handled above.",
      "name": "entity.name.type.neuro",
      "match": "\\b\\p{Lu}[\\p{L}\\p{N}_]*\\b"
    },
    "parameters": {
      "comment": "A name introduced by `(` or `,` and annotated with `:` — function parameters, and by extension the trailing fields of a struct definition or literal, which carry the same variable-ish colour.",
      "match": "(?<=[(,])\\s*([_\\p{L}][\\p{L}\\p{N}_]*)\\s*(?=:(?!:))",
      "captures": {
        "1": {
          "name": "variable.parameter.neuro"
        }
      }
    },
    "numbers": {
      "comment": "Mirrors the lexer's literal grammar: integer suffixes on integers only, float suffixes on floats only, and an exponent-only float form (`1e10`) with no decimal point.",
      "patterns": [
        {
          "name": "constant.numeric.float.neuro",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?(bf16|f16|f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.float.neuro",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*(bf16|f16|f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.hex.neuro",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*(i8|i16|i32|i64|u8|u16|u32|u64)?\\b"
        },
        {
          "name": "constant.numeric.octal.neuro",
          "match": "\\b0[oO][0-7][0-7_]*(i8|i16|i32|i64|u8|u16|u32|u64)?\\b"
        },
        {
          "name": "constant.numeric.binary.neuro",
          "match": "\\b0[bB][01][01_]*(i8|i16|i32|i64|u8|u16|u32|u64)?\\b"
        },
        {
          "name": "constant.numeric.integer.neuro",
          "match": "\\b[0-9][0-9_]*(i8|i16|i32|i64|u8|u16|u32|u64)?\\b"
        }
      ]
    },
    "operators": {
      "comment": "Every entry corresponds to a token the lexer produces. Longer forms precede the prefixes they contain, because ties at one offset go to the first rule listed. `*` is arithmetic even in dereference position and `&` is bitwise outside `&mut`/`&self`: nothing in a regex can tell those apart from multiplication and bitwise-and.",
      "patterns": [
        {
          "name": "keyword.operator.range.neuro",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.null-coalesce.neuro",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.arrow.neuro",
          "match": "->"
        },
        {
          "name": "keyword.operator.arrow.fat.neuro",
          "match": "=>"
        },
        {
          "name": "keyword.operator.path.neuro",
          "match": "::"
        },
        {
          "name": "keyword.operator.shift.neuro",
          "match": "<<"
        },
        {
          "name": "keyword.operator.comparison.neuro",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.neuro",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.compound-assign.neuro",
          "match": "[+\\-*/%]="
        },
        {
          "match": "(&)(?=\\s*\\b(?:mut|self)\\b)",
          "captures": {
            "1": {
              "name": "keyword.operator.reference.neuro"
            }
          }
        },
        {
          "name": "keyword.operator.assignment.neuro",
          "match": "(?<![=!<>+\\-*/%])=(?!=)"
        },
        {
          "name": "keyword.operator.error-propagation.neuro",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.bitwise.neuro",
          "match": "[&|^~]"
        },
        {
          "name": "keyword.operator.arithmetic.neuro",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.neuro",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.not.neuro",
          "match": "!"
        },
        {
          "name": "punctuation.accessor.neuro",
          "match": "\\."
        }
      ]
    },
    "function_calls": {
      "comment": "Listed last, so a keyword, a builtin, or a capitalised type name has already claimed the identifier before it gets here.",
      "match": "\\b([_\\p{L}][\\p{L}\\p{N}_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.neuro"
        }
      }
    }
  }
}
